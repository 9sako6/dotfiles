#!/bin/sh
set -eu

script_path=$0
case "$script_path" in
  /*) ;;
  *) script_path="$(command -v -- "$script_path" 2>/dev/null || printf '%s' "$script_path")" ;;
esac

while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *) script_path="$(CDPATH= cd -P -- "$(dirname -- "$script_path")" && pwd)/$link_target" ;;
  esac
done

script_dir="$(CDPATH= cd -P -- "$(dirname -- "$script_path")" && pwd)"
repo_dir="$(CDPATH= cd -P -- "$script_dir/../../.." && pwd)"
cd "$repo_dir"
bun_path="$(MISE_AUTO_INSTALL=0 "$HOME/.local/bin/mise" which bun)"
exec "$bun_path" "$repo_dir/bin/dot.ts" "$@"
