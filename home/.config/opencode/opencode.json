{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": "allow",
  "instructions": [
    "~/.codex/AGENTS.md"
  ],
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "high"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "high"
    }
  },
  "provider": {
    "meta": {
      "npm": "@ai-sdk/openai",
      "name": "Meta Model API",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:META_MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.2": {
          "name": "Muse Spark 1.2"
        }
      }
    }
  }
}
